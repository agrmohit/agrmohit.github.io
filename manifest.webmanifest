{
  "id": "/",
  "name": "Mohit Raj",
  "short_name": "agrmohit",
  "description": "Mohit Raj, backend developer in Bengaluru. Fluent in Go, JavaScript and Python; conversational in orbital mechanics.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "background_color": "#1a1a1a",
  "theme_color": "#1a1a1a",
  "icons": [
    { "src": "/assets/img/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/assets/img/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/img/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/img/icon-monochrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    {
      "name": "Earthrise",
      "description": "An earthrise from lunar orbit, with every parameter tunable",
      "url": "/projects/earthrise/",
      "icons": [{ "src": "/assets/img/shortcut-earthrise-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/assets/img/screenshots/home-wide.webp",
      "sizes": "1280x720",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "The home page, over an earthrise"
    },
    {
      "src": "/assets/img/screenshots/earthrise-wide.webp",
      "sizes": "1280x720",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "The earthrise lab, with its controls"
    },
    {
      "src": "/assets/img/screenshots/home-narrow.webp",
      "sizes": "824x1830",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "The home page, over an earthrise"
    },
    {
      "src": "/assets/img/screenshots/earthrise-narrow.webp",
      "sizes": "824x1830",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "The earthrise lab, with its controls"
    }
  ]
}
