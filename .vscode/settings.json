{
  // Biome runs from tools/node_modules, the version CI pins; biome.json at the repo root covers tools/ and the site's own scripts
  "biome.lsp.bin": "tools/node_modules/.bin/biome",
  "[typescript][javascript][json][jsonc]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  // type-check with TypeScript 7, as `make typecheck` does; the editor's bundled TypeScript is older
  "js/ts.experimental.useTsgo": true
}
