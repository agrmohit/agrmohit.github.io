{
  "$schema": "./tools/node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "tools/**/*.ts",
      "tools/**/*.json",
      "tools/**/*.jsonc",
      "tools/**/*.grit",
      "!tools/test/fixture",
      "assets/js/copy.js",
      "assets/js/copy-rules.js",
      "assets/js/prefetch.js",
      "assets/js/prefetch-rules.js",
      "assets/js/umami-opt-out.js",
      "assets/earthrise/arrive.js",
      "assets/earthrise/handoff.js",
      "assets/earthrise/home.js",
      "assets/earthrise/project.js",
      "assets/earthrise/transition.js",
      "biome.json"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "javascript": { "globals": ["Bun"] },
  "plugins": ["./tools/biome/no-any-sources.grit"],
  "linter": {
    "domains": { "types": "all", "project": "all", "test": "recommended" },
    "rules": {
      "complexity": { "useLiteralKeys": "off" },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "noUnresolvedImports": "error",
        "useImportExtensions": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noEvolvingTypes": "error",
        "noUnnecessaryConditions": "error",
        "noImportCycles": "error",
        "useAwait": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noEnum": "error",
        "noParameterAssign": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "useConsistentTestIt": { "level": "error", "options": { "function": "it" } }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "noUnsafeReturn": "error",
        "noUnsafeTypeAssertion": "error",
        "noUnsafePlusOperands": "error",
        "noBaseToString": "error",
        "useExhaustiveSwitchCases": "error",
        "useNullishCoalescing": "error"
      }
    }
  }
}
