// GitHub star counts for the home page, served at agrmohit.com/api/stars. Deploy with `wrangler deploy`
{
	"name": "github-stars",
	"main": "src/index.js",
	"compatibility_date": "2026-10-06",
	"routes": [
		{
			"pattern": "agrmohit.com/api/stars",
			"zone_name": "agrmohit.com"
		}
	],
	// only on the site's own domain, not on a workers.dev address as well
	"workers_dev": false,
	"preview_urls": false,
	// refresh the counts from GitHub at the top of every hour
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	// the counts, written by the cron; created by the first deploy, which wrote its id here
	"kv_namespaces": [
		{
			"binding": "STARS",
			"id": "e125a0fb467b4ca2acf50976a0d25bc6"
		}
	],
	// logs and traces of every invocation, kept 7 days; Issues groups failures, such as GitHub errors in the cron
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		},
		"issues": {
			"enabled": true
		}
	},
}
